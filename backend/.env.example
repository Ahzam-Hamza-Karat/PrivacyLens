# PrivacyLens Backend Environment Configuration
# Copy this file to .env for local development

# Server Configuration
PORT=5000
HOST=localhost
NODE_ENV=development

# Allowed CORS Origins (for local development access)
CLIENT_ORIGIN=http://localhost:5173

# Phase 6: AI Provider Configuration (Backend Only)
# Never expose real keys or commit .env with secrets to source control.
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
AI_REQUEST_TIMEOUT_MS=15000
AI_MAX_RETRIES=1

# MongoDB Database Configuration (Backend Only)
# Optional: Used for saving analysis report history with explicit user consent.
# If unconfigured or offline, transient analysis remains 100% functional,
# but saving analysis reports to database history is gracefully disabled.
MONGODB_URI=mongodb://127.0.0.1:27017/privacylens
MONGODB_DB_NAME=privacylens
MONGODB_CONNECT_TIMEOUT_MS=5000
