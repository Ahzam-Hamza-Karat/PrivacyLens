{
  "name": "privacylens",
  "version": "1.0.0",
  "description": "PrivacyLens - Plain-language explanations and evidence-backed insights for privacy policies",
  "private": true,
  "scripts": {
    "dev": "concurrently -n \"backend,frontend\" -c \"cyan,magenta\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "npm --prefix backend run dev",
    "test": "npm --prefix backend run test",
    "evaluate": "npm --prefix backend run evaluate",
    "build": "npm --prefix frontend run build",
    "install:all": "npm install && npm --prefix backend install && npm --prefix frontend install"
  },
  "keywords": [
    "privacy",
    "privacylens",
    "compliance",
    "react",
    "express"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
